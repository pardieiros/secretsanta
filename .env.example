# ============================================
# Secret Santa - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Django Backend Settings
# ============================================

# Secret Key - Generate a new one for production!
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production

# Debug Mode (True/False)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================
# Database Configuration
# ============================================
DB_NAME=secretsanta
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================
# Email Configuration
# ============================================
# For development, use console backend (prints to console)
# For production, use SMTP backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Settings (if using SMTP backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@secretsanta.com

# ============================================
# Frontend URL
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# Google OAuth2 Configuration
# ============================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH2_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ============================================
# Web Push / VAPID Configuration
# ============================================
# Generate VAPID keys using:
# python -c "from pywebpush import WebPusher; import json; keys = WebPusher.generate_keys(); print(json.dumps({'public': keys['publicKey'], 'private': keys['privateKey']}, indent=2))"
# Or use: https://web-push-codelab.glitch.me/
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUB=mailto:support@secretsanta.example

# ============================================
# Frontend Environment Variables (Vite)
# ============================================
# These are used by Vite during build time
# Note: Vite requires VITE_ prefix for environment variables

# API URL for frontend
VITE_API_URL=http://localhost:8000/api

# Google OAuth Client ID (can be same as backend or different)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Redirect URI (usually same as backend)
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ============================================
# Database Configuration (External Services)
# ============================================
# Configure these to connect to your external PostgreSQL instance
# For Docker on macOS/Windows connecting to host: use host.docker.internal
# For Docker on Linux: use the host IP or network alias
DB_NAME=secretsanta
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ============================================
# Celery Configuration (External Services)
# ============================================
# Configure these to connect to your external Redis instance
# For Docker on macOS/Windows connecting to host: use redis://host.docker.internal:6379/0
# For Docker on Linux: use redis://host-ip:6379/0 or network alias
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Soketi / WebSockets
SOCKET_APP_ID=sxxxx
SOCKET_APP_KEY=xxxx
SOCKET_APP_SECRET=xxxx
SOCKET_HOST=xxxx
SOCKET_PORT=6001
SOCKET_USE_TLS=false

VITE_SOCKET_APP_KEY=Cristina001Xpto001
VITE_SOCKET_HOST=192.168.1.73
VITE_SOCKET_PORT=6001
VITE_SOCKET_USE_TLS=false